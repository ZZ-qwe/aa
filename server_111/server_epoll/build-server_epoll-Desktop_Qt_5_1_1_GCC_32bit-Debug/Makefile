Thread_pool.o: ../../src/Thread_pool.cpp ../../include/Thread_pool.h \
		../../include/packdef.h \
		../../include/err_str.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Thread_pool.o ../../src/Thread_pool.cpp

